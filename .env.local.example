# Supabase — get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role key — NEVER expose to the browser
# Used for admin writes in Server Actions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used for canonical URLs, sitemap, OpenGraph, robots
NEXT_PUBLIC_SITE_URL=https://nepayatra.com

# Optional — Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional — Google Search Console HTML verification code (if not verified via DNS)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
